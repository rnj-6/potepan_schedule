<div class="menu_Container">
    <div class="back_Button">
        <%= link_to "←リストに戻る", posts_path %>
    </div>
    <%= link_to "編集", edit_post_path(@post), class: "btn btn-outline-success" %>
</div>

<h2><%= @post.title %></h2>
<div>
    <table class="show_Table">
        <tr>
            <th>開始日</th>
            <td><%= @post.start_date.strftime("%Y/%m/%d") %></td>
        </tr>
        <tr>
            <th>終了日</th>
            <td><%= @post.end_date.strftime("%Y/%m/%d") %></td>
        </tr>
        <tr>
            <th>終日</th>
            <td><%= @post.all_day ? "〇" : "" %></td>
        </tr>
        <tr>
            <th>メモ</th>
            <td><%= @post.body %></td>
        </tr>
    </table>
</div>